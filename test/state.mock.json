{
  "user": {
    "email": "dev@example.com"
  },
  "projects": {
    "developit/preact-vite-template": {
      "repo": "https://github.com/developit/preact-vite-template.git",
      "branch": "main",
      "cloneMethod": "http",
      "harnesses": ["opencode"],
      "sessions": {
        "main": {},
        "oc1": { "harness": "opencode" }
      },
      "shortcuts": [
        { "id": "qc-dev", "alias": "dev", "kind": "cmd", "command": "npm install && npm start -- --host 0.0.0.0" },
        { "id": "default-esc", "alias": "Esc", "kind": "keys", "keys": "Esc" },
        { "id": "default-tab", "alias": "Tab", "kind": "keys", "keys": "Tab" },
        { "id": "default-up", "alias": "Up", "kind": "keys", "keys": "Up" },
        { "id": "default-down", "alias": "Down", "kind": "keys", "keys": "Down" },
        { "id": "default-left", "alias": "Left", "kind": "keys", "keys": "Left" },
        { "id": "default-right", "alias": "Right", "kind": "keys", "keys": "Right" },
        { "id": "default-ctrl-c", "alias": "Ctrl-C", "kind": "keys", "keys": "Ctrl-C" },
        { "id": "default-ctrl-d", "alias": "Ctrl-D", "kind": "keys", "keys": "Ctrl-D" }
      ]
    }
  },
  "harnesses": {
    "cline": {
      "id": "cline",
      "name": "Cline",
      "command": "cline",
      "install": "npm i -g cline"
    },
    "freebuff": {
      "id": "freebuff",
      "name": "Freebuff",
      "command": "freebuff",
      "install": "npm i -g freebuff && freebuff --version || true"
    },
    "opencode": {
      "id": "opencode",
      "name": "OpenCode",
      "command": "opencode",
      "install": "npm i -g opencode-ai"
    },
    "terminal": {
      "id": "terminal",
      "name": "Terminal",
      "command": "bash"
    }
  }
}
