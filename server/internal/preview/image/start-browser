#!/bin/sh
set -eu

DISPLAY="${DISPLAY:-:99}"
WIDTH="${WIDTH:-1280}"
HEIGHT="${HEIGHT:-800}"
CDP_PORT="${CDP_PORT:-9222}"
VNC_WEB_PORT="${VNC_WEB_PORT:-6080}"
CDP_PROXY_PORT="${CDP_PROXY_PORT:-9223}"
TARGET="${BROWSER_TARGET:-http://127.0.0.1:3000}"
PROFILE="${BROWSER_PROFILE:-/tmp/pcoder-browser-profile}"

export DISPLAY

# Prefer the sandbox: the --no-sandbox infobar eats preview space, so only
# fall back to it on hosts whose kernel refuses user namespaces (there the
# preview still works, bar included).
SANDBOX="--no-sandbox"
if chromium --headless --disable-gpu --disable-dev-shm-usage --dump-dom about:blank >/dev/null 2>&1; then
	SANDBOX=""
fi

# Xtigervnc is display and VNC server in one process, and — unlike Xvfb — it
# can resize the desktop at runtime: the noVNC entry page asks for the
# iframe's size (resizeSession) and the desktop follows. WIDTH/HEIGHT only
# seed the first desktop; the server resizes the Chromium window via CDP on
# every viewport sync. -localhost -SecurityTypes None matches x11vnc's old
# -localhost -nopw posture: no VNC password, reachable only through
# websockify behind the preview token.
Xtigervnc "$DISPLAY" \
	-geometry "${WIDTH}x${HEIGHT}" \
	-depth 24 \
	-rfbport 5900 \
	-localhost \
	-SecurityTypes None \
	-AlwaysShared \
	-desktop pcoder &
display_socket="/tmp/.X11-unix/X${DISPLAY#:}"
for attempt in $(seq 1 100); do
	if [ -S "$display_socket" ]; then
		break
	fi
	sleep 0.1
done
if [ ! -S "$display_socket" ]; then
	echo "Xtigervnc did not create $display_socket" >&2
	exit 1
fi
# websockify serves the entry page (pcoder.html) which asks the VNC server to
# resize the desktop to the iframe's CSS size on connect and every resize.
websockify --verbose --web=/usr/share/novnc "$VNC_WEB_PORT" 127.0.0.1:5900 &
# Chromium's DevTools HTTP server only binds localhost (remote-debugging
# -address is ineffective here), so forward it for the Go server, which
# lives in a different network namespace.
socat "TCP-LISTEN:${CDP_PROXY_PORT},fork,bind=0.0.0.0,reuseaddr" TCP:127.0.0.1:"$CDP_PORT" &

exec chromium \
	$SANDBOX \
	--disable-gpu \
	--disable-dev-shm-usage \
	--remote-debugging-address=0.0.0.0 \
	--remote-debugging-port="$CDP_PORT" \
	--user-data-dir="$PROFILE" \
	--window-size="${WIDTH},${HEIGHT}" \
	--app="$TARGET" \
	--no-first-run \
	--disable-infobars \
	--disable-features=Translate \
	--disable-extensions
